# Worksection MCP Server Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# OAuth2 Configuration (REQUIRED)
# =============================================================================
# Get these from your Worksection OAuth2 app settings
WORKSECTION_CLIENT_ID=your_client_id_here
WORKSECTION_CLIENT_SECRET=your_client_secret_here

# Your Worksection account URL (without trailing slash)
WORKSECTION_ACCOUNT_URL=https://yourcompany.worksection.com

# OAuth2 redirect URI - must match the one registered in your Worksection app
# NOTE: Worksection requires HTTPS for OAuth2 redirect URIs
WORKSECTION_REDIRECT_URI=https://localhost:8080/oauth/callback

# OAuth2 scopes (comma-separated, no spaces)
# Read:  projects_read, tasks_read, costs_read, tags_read, comments_read, files_read, users_read, contacts_read, administrative
# Write: projects_write, tasks_write, costs_write, tags_write, comments_write, files_write, users_write, contacts_write
# NOTE: write scopes must also be granted to your Worksection OAuth2 app, and a
# re-authorization is required for a new scope to take effect on the token.
WORKSECTION_SCOPES=projects_read,tasks_read,costs_read,tags_read,comments_read,files_read,users_read,contacts_read,administrative

# =============================================================================
# Write Operations (mutations) — DISABLED BY DEFAULT
# =============================================================================
# Master kill-switch for all mutating tools (add_comment, create_task,
# update_task, complete_task, reopen_task, set_task_status). When false, every
# write tool refuses to run regardless of token scopes. To enable writes:
#   1. Add the needed *_write scopes above (tasks_write + comments_write cover
#      task create/edit/status + comments; add tags_write for set_task_status).
#   2. Grant those write scopes to the OAuth app in Worksection admin.
#   3. Re-authenticate (delete data/tokens/tokens.enc, restart, complete OAuth).
#   4. Set WORKSECTION_ENABLE_WRITES=true.
WORKSECTION_ENABLE_WRITES=false

# =============================================================================
# OAuth2 Flow Settings
# =============================================================================
# Host and port for the OAuth callback server
OAUTH_CALLBACK_HOST=localhost
OAUTH_CALLBACK_PORT=8080

# Automatically open browser for OAuth authorization
OAUTH_AUTO_OPEN_BROWSER=true

# Fall back to the interactive browser flow when no usable token is stored.
# Set to false when the registered redirect URI is not a local callback: startup
# then fails with a clear error instead of blocking on a flow that cannot finish.
OAUTH_INTERACTIVE_FALLBACK=true

# =============================================================================
# SSL Configuration for OAuth Callback
# =============================================================================
# Use HTTPS for OAuth callback server (required by Worksection)
OAUTH_CALLBACK_USE_SSL=true

# Path to SSL certificate file (auto-generated if missing)
OAUTH_SSL_CERT_PATH=./data/certs/callback.crt

# Path to SSL private key file (auto-generated if missing)
OAUTH_SSL_KEY_PATH=./data/certs/callback.key

# Certificate validity in days for auto-generated certificates
OAUTH_SSL_CERT_DAYS=3650

# =============================================================================
# Token Management
# =============================================================================
# Directory for storing encrypted tokens
TOKEN_STORAGE_PATH=./data/tokens

# Encryption key for tokens (auto-generated if empty)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# =============================================================================
# File Caching
# =============================================================================
# Directory for cached file attachments
FILE_CACHE_PATH=./data/files

# How long to keep cached files (hours)
FILE_CACHE_RETENTION_HOURS=72

# Maximum file size to cache (MB)
MAX_FILE_SIZE_MB=100

# =============================================================================
# Large Response Handling
# =============================================================================
# Automatically offload oversized MCP tool responses to files
LARGE_RESPONSE_OFFLOAD_ENABLED=true

# Directory for offloaded response files
LARGE_RESPONSE_OFFLOAD_PATH=./data/offload

# Serialized response size in bytes above which responses are offloaded (0 disables).
# Default is conservative for strict MCP client inline response limits.
# Raise only if your MCP client accepts larger inline tool responses.
LARGE_RESPONSE_OFFLOAD_THRESHOLD_BYTES=50000

# How long to keep offloaded response files (hours)
LARGE_RESPONSE_OFFLOAD_RETENTION_HOURS=24

# Maximum number of offloaded response files to retain
LARGE_RESPONSE_OFFLOAD_MAX_FILES=100

# Include local filesystem file_path in offload metadata.
# Disabled by default; use resource_uri/helper tools unless local paths are required.
LARGE_RESPONSE_OFFLOAD_INCLUDE_FILE_PATH=false

# Maximum raw bytes requested by offloaded response read helper tools.
# The helper may return fewer bytes to keep the serialized MCP response safe.
# Must be at least 4 bytes so UTF-8 chunk reads can always advance safely.
# Raise only if your MCP client accepts larger helper tool responses.
LARGE_RESPONSE_MAX_READ_BYTES=50000

# =============================================================================
# MCP Server Configuration
# =============================================================================
# Server name (used in MCP protocol)
MCP_SERVER_NAME=worksection

# Server bind host for HTTP transports (streamable-http):
# - 127.0.0.1: local machine only (default, safer)
# - 0.0.0.0: LAN/external access
MCP_SERVER_HOST=127.0.0.1

# Server port for HTTP transports
MCP_SERVER_PORT=8000

# Transport type: streamable-http (recommended) or stdio
MCP_TRANSPORT=streamable-http

# =============================================================================
# Runtime Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable ANSI colors for log levels in terminal output
LOG_USE_COLORS=true

# Request/access log verbosity: INFO, DEBUG, OFF
REQUEST_LOG_MODE=INFO

# Suppress the FastMCP startup banner in server logs
FASTMCP_SHOW_SERVER_BANNER=false

# Environment: development, staging, production
ENVIRONMENT=development
